# Packaging build image for rmstory-opensuse-tumbleweed. Bakes in every
# dependency packaging/build-rpm.sh needs, on the same distro the package
# targets -- generated from (and must be kept in sync with) the combo
# definition in ../../../.github/workflows/build-packages.yml.
#
# python3-wheel: rmstory.spec's suse branch lists `%{suse_py_pkg}-wheel`
# in BuildRequires unconditionally (needed on SLES 15 SP7's older
# setuptools -- see rmstory.spec and packaging/README.md), so it has to
# actually be present here too even though Tumbleweed's own newer
# setuptools doesn't strictly need it at build time.
FROM opensuse/tumbleweed

RUN zypper --non-interactive install rpm-build python3 python3-devel python3-setuptools python3-wheel python3-pip python3-pytest python3-PyYAML tar git && \
    zypper clean --all
